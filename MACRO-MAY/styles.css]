/* ─────────────────────────────────────────────────────────────
   MacroSnaps v2 (MACRO-MAY)
   Light mode · orange palette · coral bullets
   ───────────────────────────────────────────────────────────── */

* { margin: 0; padding: 0; box-sizing: border-box; }

:root {
  --orange: #F97316;
  --orange-dark: #C2410C;
  --coral: #CC785C;
  --green: #00b074;
  --red: #d93a4f;
  --text: #1a1a1a;
  --text-2: #333;
  --text-3: #444;
  --text-4: #555;
  --text-5: #888;
  --text-6: #999;
  --border: rgba(0,0,0,.06);
  --border-2: rgba(0,0,0,.04);
  --surface: #f5f5f4;
  --card: #fff;
  --pill-bg: rgba(0,0,0,.04);
  --font-display: 'Space Mono', ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
  --font-body: 'DM Sans', system-ui, -apple-system, sans-serif;
}

html { background: var(--surface); color: var(--text); font-family: var(--font-body); -webkit-font-smoothing: antialiased; }
body { min-height: 100vh; padding: 0; }

a { color: var(--orange-dark); text-decoration: none; }
a:hover { text-decoration: underline; }

.page { max-width: 760px; margin: 0 auto; padding: 18px 16px 64px; }

/* ── Box (the modular container) ─────────────────────────────── */
.box {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 20px 22px;
  margin-bottom: 14px;
}
.box.compact { padding: 16px 22px; }
a.box { display: block; color: inherit; cursor: pointer; transition: border-color .15s, transform .05s; }
a.box:hover { border-color: rgba(0,0,0,.12); text-decoration: none; }
a.box:active { transform: scale(.998); }

/* ── Header ───────────────────────────────────────────────────── */
.head-row {
  display: flex; align-items: center; justify-content: space-between;
  padding-bottom: 14px; border-bottom: 1px solid var(--border); margin-bottom: 18px;
}
.head-row.no-divider { padding-bottom: 0; border-bottom: none; margin-bottom: 0; }
.back-link {
  font-family: var(--font-display); font-size: 10px; letter-spacing: 1.4px;
  text-transform: uppercase; color: var(--text-5); text-decoration: none;
}
.back-link:hover { color: var(--text-3); text-decoration: none; }
.date {
  font-family: var(--font-display); font-size: 10px; letter-spacing: 1.4px;
  text-transform: uppercase; color: var(--text-5);
}
.brand {
  margin: 0; font-size: 22px; font-weight: 500; letter-spacing: -.01em; line-height: 1;
}
.country-title { display: flex; align-items: baseline; gap: 14px; }
.country-title h1 {
  margin: 0; font-size: 30px; font-weight: 500; letter-spacing: -.02em; line-height: 1;
}
.flag-pill {
  font-family: var(--font-display); font-size: 10px; letter-spacing: 1.6px;
  color: var(--text-5); background: var(--pill-bg); padding: 3px 10px; border-radius: 3px; font-weight: 500;
}

/* ── Section label (the small uppercase header inside a box) ───── */
.section-label {
  font-family: var(--font-display); font-size: 10px; letter-spacing: 1.6px;
  text-transform: uppercase; color: var(--text-5); margin-bottom: 14px;
}

/* ── Stories list (numbered with coral circles) ─────────────────── */
.stories { list-style: none; padding: 0; margin: 0; counter-reset: story; }
.stories li {
  counter-increment: story;
  font-size: 15px; color: var(--text-2); line-height: 1.65;
  padding-left: 30px; position: relative; margin-bottom: 11px;
}
.stories li:last-child { margin-bottom: 0; }
.stories li::before {
  content: counter(story);
  position: absolute; left: 0; top: 3px;
  width: 18px; height: 18px; display: flex; align-items: center; justify-content: center;
  border-radius: 50%; border: 1.5px solid var(--coral); color: var(--coral);
  font-size: 11px; font-weight: 700; font-family: var(--font-body);
}
.stories.sm li { font-size: 14px; color: var(--text-3); padding-left: 28px; margin-bottom: 8px; }
.stories.sm li::before { width: 17px; height: 17px; font-size: 10px; }

/* ── Snapshot table ─────────────────────────────────────────────── */
.snapshot {
  width: 100%; border-collapse: collapse;
  font-family: var(--font-display); font-size: 12px;
  font-variant-numeric: tabular-nums; table-layout: fixed;
}
.snapshot th, .snapshot td { padding: 8px 4px; text-align: right; border-bottom: 1px solid var(--border-2); }
.snapshot thead th { border-bottom: 1px solid rgba(0,0,0,.1); font-weight: 500; color: var(--text-5); font-size: 9px; letter-spacing: 1.4px; text-transform: uppercase; }
.snapshot th.sortable { cursor: pointer; user-select: none; transition: color .15s; }
.snapshot th.sortable:hover { color: var(--text-3); }
.snapshot th.sortable.active { color: var(--orange-dark); }
.snapshot th .sort-arrow { display: inline-block; margin-left: 3px; color: var(--orange-dark); font-size: 10px; min-width: 6px; }
.snapshot td:first-child, .snapshot th:first-child { text-align: left; padding-left: 6px; }
.snapshot td:first-child { color: var(--text); font-weight: 500; transition: color .15s; }
.snapshot tbody tr:last-child td { border-bottom: none; }
.snapshot tbody tr.clickable { cursor: pointer; transition: background-color .15s; }
.snapshot tbody tr.clickable:hover { background: rgba(249,115,22,.05); }
.snapshot tbody tr.clickable:hover td:first-child { color: var(--orange-dark); }
.pos { color: var(--green); }
.neg { color: var(--red); }
.muted { color: var(--text-6); }

/* ── Country card ────────────────────────────────────────────────── */
.country-card-head {
  display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px;
}
.country-card-name { display: flex; align-items: center; gap: 11px; }
.country-card-name h2 { margin: 0; font-size: 17px; font-weight: 500; }
.country-card-arrow { color: var(--orange-dark); font-size: 14px; }

/* ── Metric box ───────────────────────────────────────────────────── */
.metric-head {
  display: flex; align-items: baseline; justify-content: space-between;
  margin-bottom: 20px; gap: 14px;
}
.metric-head h2 {
  margin: 0; font-size: 26px; font-weight: 500; letter-spacing: -.01em; line-height: 1.1;
}
.metric-value {
  font-size: 26px; font-weight: 500; color: var(--text);
  font-variant-numeric: tabular-nums; letter-spacing: -.01em; line-height: 1; white-space: nowrap;
}

/* ── Chart panel (ported from existing site) ──────────────────────── */
.metric-chart-wrap {
  margin: 10px 0 0; padding: 12px 0 4px;
  border-top: 1px solid var(--border);
}
.metric-chart-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; }
.metric-chart-title {
  font-family: var(--font-display); font-size: 8px; letter-spacing: 1.5px;
  text-transform: uppercase; color: var(--text-5);
}
.metric-chart-range { display: flex; gap: 2px; }
.mcr-btn {
  font-family: var(--font-display); font-size: 8px; letter-spacing: .5px;
  text-transform: uppercase; padding: 3px 8px;
  border: 1px solid rgba(0,0,0,.08); border-radius: 2px;
  background: transparent; color: var(--text-5); cursor: pointer; transition: all .15s;
}
.mcr-btn:hover { border-color: rgba(249,115,22,.4); color: var(--text-3); }
.mcr-btn.active {
  background: rgba(249,115,22,.08); border-color: rgba(249,115,22,.35);
  color: var(--orange-dark);
}
.metric-chart-canvas { height: 140px; position: relative; }
.metric-chart-canvas canvas { width: 100% !important; height: 100% !important; }

/* ── Glossary block ───────────────────────────────────────────────── */
.gloss { margin-top: 14px; padding-top: 14px; border-top: 1px solid var(--border); }
.gloss-title {
  font-family: var(--font-display); font-size: 9px; letter-spacing: 1.2px;
  text-transform: uppercase; color: var(--text-5); margin-bottom: 6px;
}
.gloss-body { font-size: 13px; color: var(--text-4); line-height: 1.6; margin: 0; }
.gloss-source {
  font-family: var(--font-display); font-size: 8px; letter-spacing: .8px;
  color: var(--text-6); margin-top: 12px;
}

/* ── FX regime callout (USD/DXY etc.) ─────────────────────────────── */
.fx-regime {
  background: rgba(249,115,22,.05); border-left: 2px solid rgba(249,115,22,.5);
  padding: 13px 15px; margin-top: 14px; border-radius: 0 4px 4px 0;
}
.fx-regime .fx-label {
  font-family: var(--font-display); font-size: 9px; letter-spacing: 1.2px;
  text-transform: uppercase; color: var(--orange-dark); margin-bottom: 6px;
}
.fx-regime p { font-size: 13px; line-height: 1.6; color: var(--text-3); margin: 0; }

/* ── Commodities ──────────────────────────────────────────────────── */
.commodities-grid {
  display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px 22px;
}
.commodity-item .c-name {
  font-family: var(--font-display); font-size: 9px; letter-spacing: 1.2px;
  text-transform: uppercase; color: var(--text-5); margin-bottom: 4px;
}
.commodity-item .c-value {
  font-family: var(--font-display); font-size: 15px; font-weight: 500;
  color: var(--text); font-variant-numeric: tabular-nums;
}
.commodity-item .c-change { font-size: 11px; font-weight: 400; margin-left: 4px; }

/* ── Countries grid (homepage) ──────────────────────────────────── */
.countries-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px 14px;
}
.country-tile {
  display: flex; flex-direction: column; align-items: center;
  text-align: center; gap: 9px;
  padding: 6px 4px;
  border-radius: 6px;
  color: inherit; text-decoration: none;
  transition: transform .15s, background .15s;
}
.country-tile:hover {
  background: rgba(0,0,0,.025);
  text-decoration: none;
  transform: translateY(-2px);
}
.flag-rect {
  width: 80px; height: 60px;
  border-radius: 6px;
  overflow: hidden;
  border: 1px solid rgba(0,0,0,.1);
  box-shadow: 0 1px 2px rgba(0,0,0,.04);
  background: #fff;
  transition: border-color .15s, box-shadow .15s;
}
.country-tile:hover .flag-rect {
  border-color: var(--orange);
  box-shadow: 0 2px 6px rgba(249,115,22,.18);
}
.flag-rect svg {
  display: block;
  width: 100%; height: 100%;
}
.country-tile-name {
  font-size: 13px;
  font-weight: 500;
  color: var(--text-2);
  line-height: 1.2;
}

/* ── Empty/placeholder ─────────────────────────────────────────────── */
.note {
  text-align: center; padding: 18px;
  font-family: var(--font-display); font-size: 9px; letter-spacing: 1px;
  text-transform: uppercase; color: var(--text-6);
}

/* ── Footer ────────────────────────────────────────────────────────── */
.footer {
  text-align: center; padding: 24px 12px; margin-top: 18px;
  font-family: var(--font-display); font-size: 9px; letter-spacing: 1.2px;
  text-transform: uppercase; color: var(--text-6);
}
.footer a { color: var(--text-5); }

/* ── Responsive ────────────────────────────────────────────────────── */
@media (max-width: 600px) {
  .page { padding: 12px 10px 48px; }
  .box { padding: 16px 16px; }
  .country-title h1 { font-size: 26px; }
  .metric-head h2 { font-size: 22px; }
  .metric-value { font-size: 22px; }
  .commodities-grid { grid-template-columns: repeat(2, 1fr); }
  .countries-grid { grid-template-columns: repeat(3, 1fr); gap: 16px 8px; }
  .flag-rect { width: 64px; height: 48px; }
  .country-tile-name { font-size: 12px; }
  .snapshot { font-size: 11px; }
  .snapshot th, .snapshot td { padding: 11px 3px; }
}
